# Frontend environment. Both values are PUBLIC by design - they are compiled
# into the browser bundle, which is why they carry the NEXT_PUBLIC_ prefix.
#
# NEVER put SUPABASE_KEY (service_role) or FERNET_KEY in this file or in any
# Vercel variable for this project. Those decrypt every participant's exchange
# credentials; they belong only to the Railway backend service.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# The ANON key. RLS is what constrains it - see the policies at the bottom of
# ../migrations/schema.sql.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Competition window (optional)
# ---------------------------------------------------------------------------
#
# Shown in the leaderboard header. Keep them in step with the backend's
# COMPETITION_START / COMPETITION_END (see ../.env.example), or the board
# advertises one window while metrics.py scores another.
#
# Set each to the DATE you want displayed. A full timestamp is accepted and
# its leading date is used - but that is not always the backend's value
# verbatim: the backend wants the last INSTANT that counts, so an end of
# 2026-10-27T00:00:00Z scores through the 26th and would display as the 27th.
#
# Unset falls back to the dates the page shipped with, and an unparseable
# value is ignored with a warning in the build log.
#
# NEXT_PUBLIC_* is inlined at BUILD time: changing these on Vercel requires a
# redeploy, not just a save.
NEXT_PUBLIC_COMPETITION_START=
NEXT_PUBLIC_COMPETITION_END=
